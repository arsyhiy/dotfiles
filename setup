#!/usr/bin/env bash

set -Eeuo pipefail

clear
cat <<'.'
 ______   _______  _______  _______  ___   ___      _______  _______ 
|      | |       ||       ||       ||   | |   |    |       ||       |
|  _    ||   _   ||_     _||    ___||   | |   |    |    ___||  _____|
| | |   ||  | |  |  |   |  |   |___ |   | |   |    |   |___ | |_____ 
| |_|   ||  |_|  |  |   |  |    ___||   | |   |___ |    ___||_____  |
|       ||       |  |   |  |   |    |   | |       ||   |___  _____| |
|______| |_______|  |___|  |___|    |___| |_______||_______||_______|
.
printf "                                                      made by arsyhiy\n"
printf "\n"
printf "=======================================================================\n"

# installing section
printf "\n"
printf "=== installing =================================================================\n"

packages=(
	stow
	tmux
    vim
	lazygit
    unzip
    curl
    npm
    pkg-config 
)

log_file="$HOME/setup.log"

for pkg in "${packages[@]}"; do
    if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed"; then
        echo "$pkg already installed."
    else
        echo "Installing $pkg..."

        if sudo apt install -y "$pkg"; then
            echo "$pkg installed successfully."
        else
            echo "$pkg failed" | tee -a "$log_file"
        fi
    fi
done

# other section
printf "\n"
printf "=== other ======================================================================\n"

# zsh
sudo apt install -y zsh

## ohmyzsh
sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

## zsh autosuggestions
git clone https://github.com/zsh-users/zsh-autosuggestions \
${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions

# build neovim

# download all requirements
sudo apt-get install ninja-build gettext cmake unzip curl

git clone https://github.com/neovim/neovim

cd neovim

git checkout stable

make CMAKE_BUILD_TYPE=RelWithDebInfo

sudo make install

cd .. 
rm -rf neovim

# install ghostty
sudo /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)"

# install fonts 
curl -fsSL https://raw.githubusercontent.com/officialrajdeepsingh/nerd-fonts-installer/main/install.sh | bash -s -- JetBrainsMono

# rust
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh

# omp
curl -fsSL https://omp.sh/install | sh

# stow section
printf "\n"
printf "=== stow =======================================================================\n"

sudo stow tmux vim zsh ghostty nvim emacs

printf "\n"
printf "=======================================================================\n"
printf "Setup finished."
printf "\n"
