#!/usr/bin/env python3

import curses
import subprocess

ACTIONS = [
    ("Lock", ["swaylock", "-f", "-c", "000000"]),
    ("Logout", ["swaymsg", "exit"]),
    ("Suspend", ["systemctl", "suspend"]),
    ("Reboot", ["systemctl", "reboot"]),
    ("Shutdown", ["systemctl", "poweroff"]),
    ("Cancel", None),
]


def confirm(stdscr, action):
    stdscr.clear()
    stdscr.addstr(0, 0, f"Are you sure you want to {action}?")
    stdscr.addstr(2, 0, "Y - confirm | N / Esc - cancel")
    stdscr.refresh()

    while True:
        key = stdscr.getch()

        if key in (ord("y"), ord("Y")):
            return True

        if key in (ord("n"), ord("N"), 27):
            return False


def main(stdscr):
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()

    curses.init_pair(1, curses.COLOR_WHITE, -1)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_WHITE)

    selected = 0

    while True:
        stdscr.clear()
        height, width = stdscr.getmaxyx()

        title = "SYSTEM"
        stdscr.addstr(1, max(0, (width - len(title)) // 2),
                      title, curses.A_BOLD)

        for i, (name, _) in enumerate(ACTIONS):
            y = 3 + i

            if y >= height - 1:
                break

            x = max(0, (width - len(name)) // 2)

            if i == selected:
                stdscr.addstr(y, x, name, curses.color_pair(2))
            else:
                stdscr.addstr(y, x, name, curses.color_pair(1))

        stdscr.addstr(height - 1, 0, "↑/↓ or j/k | Enter | Esc")
        stdscr.refresh()

        key = stdscr.getch()

        if key in (curses.KEY_UP, ord("k")):
            selected = (selected - 1) % len(ACTIONS)

        elif key in (curses.KEY_DOWN, ord("j")):
            selected = (selected + 1) % len(ACTIONS)

        elif key in (10, 13, curses.KEY_ENTER):
            name, command = ACTIONS[selected]

            if command is None:
                return

            if name in ("Reboot", "Shutdown"):
                if not confirm(stdscr, name.lower()):
                    continue

            curses.endwin()
            subprocess.Popen(command)
            return

        elif key == 27:
            return


if __name__ == "__main__":
    curses.wrapper(main)
