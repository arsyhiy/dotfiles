{
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "hyprland/language",
        "pulseaudio",
        "network",
        "battery"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "format-icons": {
            "active": "●",
            "default": "○"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "keyboard-state": {
        "numlock": false,
        "capslock": false,
        "format": "{layout}",
        "format-en": "US",
        "format-ru": "RU"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "muted",
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "offline",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "battery": {
        "format": "{capacity}%",
        "format-charging": "{capacity}% +",
        "format-full": "{capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    }
}
