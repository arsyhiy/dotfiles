{
    "layer": "top",
    "height": 32,
    "spacing": 4,
    "margin-top": 5,
    "margin-left": 12,
    "margin-right": 12,
    "margin-bottom": 0,

    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad",
        "sway/window"
    ],

    "modules-center": ["clock"],

    "modules-right": [
        "custom/swayidle",
        "sway/language",
        "pulseaudio",
        "network",
        "battery",
        "clock"
    ],

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "sway/window": {
        "format": " {app_id}",
        "max-length": 50
    },

    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "sway/language": {
        "format": "{}",
        "tooltip": false
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "   {:%H:%M}",
        "format-alt": "{:%Y-%m-%d}  "
    },

    "battery": {
        "states": {
            "good": 52,
            "warning": 30,
            "critical": 30
        },
        "format": "<span font='Font Awesome 5 Free 11'>{icon}</span> {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time}{icon}",
        "format-full": " Battery is full",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },

    "battery#bat2": {
        "bat": "BAT2"
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "⚠ Disconnected",
        "on-click": "rofi-wifi-menu/rofi-wifi-menu.sh"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        }
    },

"custom/swayidle": {
    "exec": "~/.local/bin/swayidle-toggle status",
    "interval": 2,
    "return-type": "json",
    "on-click": "~/.local/bin/swayidle-toggle toggle"
},

}
